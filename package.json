{
  "name": "go-100-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "tsx server/index.ts",
    "build": "npm run typecheck && npm run check:content && vite build",
    "start": "tsx server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "check:content": "tsx scripts/check-content.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:go": "tsx scripts/verify-go.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.0",
    "@fastify/static": "^10.1.6",
    "@remotion/player": "4.0.536",
    "@uiw/react-codemirror": "^4.25.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.577.0",
    "mermaid": "12.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.536",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
